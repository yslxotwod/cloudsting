#desc: Who am I, what can I reach, what did I leave behind
# The credential-first chain: validate what is on the box, then map the account
# it belongs to, then the escalation paths out of it.
module 01 --status-tsv
module 06 --whoami
module 04 --probe
module 04 --techniques
module 05 --map
module 07 --list
module 22 --posture
module 23 --footholds
continue

# once instance metadata is closed the credentials are not gone, they moved
# into a store the workload reads at boot: ask what this identity can list
# before assuming the account is clean
module 17 --state
module 17 --enumerate

# and both HTTP-native stores are routinely reachable without a token, which
# makes the mount table, the policy names and every application property
# readable; a config server also echoes its own git uri, credentials included
module 17 --surface $TARGET
module 17 --paths

# nothing here prints a secret: the report is the shape, the length and a
# fingerprint, which is enough to prove access and useless to a reader
module 17 --classify

# the mail path is not credentials, but it is the trust an identity rests on:
# a relay that forwards for strangers needs no account either
module 19 --relay "$TARGET"

# and an exposed mailbox list is an identity list, which is what the rest of
# this playbook then tries against
module 19 --enum "$TARGET"
