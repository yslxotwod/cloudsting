#desc: API surface — secrets in a tree, spec analysis, JWT and auth families
# Needs a path or a URL; nothing here guesses one.
require TARGET
module 08 --scan "$TARGET"
module 01 --list-formats
module 44 --list
module 62 --versions
continue

# identity is only half the surface: the guard can be on the wrong route
module 47 --gaps $TARGET

# and a single locked route can answer to a header or a trailing slash
module 47 --methods $TARGET /api/admin/users

# every OAuth deployment answers the same questions: what does it publish
# about itself, does the registration check hold, and did it leave implicit on
module 45 --check $TARGET
module 45 --paths
module 45 --tests

# a duplicate parameter is the cheapest way past a badly aligned gateway; the
# table covers the shapes that actually fold
module 51 --list
module 51 --params

# injection is a family question, not a payload question: name the parameter and
# let the families argue
module 53 --families
module 53 --payloads

# smuggling is a parser question: the table names every pair that can disagree
module 59 --techniques
module 59 --framing

# and the browser is the one willing client: if the origin is echoed with
# credentials, a page on that origin reads the session for free
module 61 --origins
module 61 --origins $TARGET

# cost is the last free lever: a query nobody metered will answer the same
# question a thousand times, and the curve is what shows it
module 68 --techniques
module 68 --rungs
module 68 --probe $TARGET

# a socket is an HTTP upgrade followed by frames, so the handshake is the only
# part an HTTP tool sees — the origin check is the whole CSWSH guard
module 57 --paths
module 57 --origins

# a gRPC endpoint that answers reflection hands out its own service catalogue
module 56 --codes
module 56 --payloads

# a name that resolves twice defeats a filter that validates the name and a
# fetcher that talks to the address — two different lookups, one attack
module 27 --targets
module 27 --addresses

# a stream is one response that never ends, so nothing that reads a code and a
# header block ever sees what came down it
module 58 --paths

# a response that a cache will store is how one user's splice reaches another
module 60 --vectors
module 60 --params

# a list endpoint that hands over the table is silent: the response looks
# exactly like a correctly paginated one
module 63 --params
module 63 --verdicts

# a deserializer that rebuilt our object says so by answering where it should
# have refused — the control carries a body of the format it claimed to want
module 65 --formats
module 65 --scan $TARGET

# a webhook that accepts a request it should have refused is the whole finding;
# the control proves the endpoint is signed before anything else is read
module 66 --schemes
module 66 --check $TARGET

# a refresh token is a second key to the same door; the question is never
# "did logout return 200" but "does the artifact still work afterwards"
module 67 --grants
module 67 --vectors

# a signed request is only a defence if the server remembers it; the nonce
# store is consulted before the side effect and written after, and the window
# between those two lines is the whole bug
module 78 --vectors
module 78 --list

# 56 finds the service; 69 asks whether the decoder and the type agree about
# what the bytes mean, which is a different question with a different answer
module 69 --techniques
module 69 --wire

# 42 reads one spec and asks how bad it is; 70 reads two and asks what moved —
# the interesting answer is never "an endpoint was added"
module 70 --classes

module 71 --probe $TARGET
module 71 --techniques
module 72 --probe $TARGET
module 74 --lease $TARGET
module 75 --techniques
module 77 --probe $TARGET
